        {
          "title": "Make the marinade",
          "content": "In a bowl, mix the chopped garlic, Dijon mustard, honey, soy sauce, olive oil, lemon juice and sweet paprika into a thick, even paste.",
          "image_alt": "Mustard, honey, garlic, soy sauce and paprika marinade in a bowl",
          "image_url": "/recetas/bondiola-de-cerdo/paso-02.webp"
        },
        {
          "title": "Marinate and let it rest",
          "content": "Coat the piece on all sides with the marinade, using a brush or clean hands. Cover and refrigerate for at least 1 hour; if you can, leave it overnight so the garlic and salt penetrate.",
          "image_alt": "Pork neck coated in marinade, ready to rest in the fridge",
          "image_url": "/recetas/bondiola-de-cerdo/paso-03.webp"
        },
        {
          "title": "Brown the pork",
          "content": "Preheat the oven to 320°F (160°C) with the rack in the center. Heat a large skillet over medium-high heat and brown the piece for 3 to 4 minutes per side, until the surface is toasted. The honey darkens fast: watch that it doesn't burn.",
          "image_alt": "Pork neck browning in a cast-iron skillet",
          "image_url": "/recetas/bondiola-de-cerdo/paso-04.webp"
        },
        {
          "title": "Roast covered for 2 hours",
          "content": "Transfer the piece to a roasting pan with 200 ml of water in the bottom and cover with foil. Roast at 320°F (160°C) for 2 hours: slow, moist cooking softens the cut's connective tissue.",
          "image_alt": "Pork neck covered with foil inside the oven",
          "image_url": "/recetas/bondiola-de-cerdo/paso-05.webp"
        },
        {
          "title": "Uncover and caramelize",
          "content": "Remove the foil, raise the oven to 392°F (200°C) and roast 15 to 20 minutes more, until the surface is dark and glossy. Check the thickest part with a thermometer: for a tender result it should read 176–185°F (80–85°C) (the safe minimum is 145°F/63°C).",
          "image_alt": "Caramelized pork neck with a thermometer inserted in the center",
          "image_url": "/recetas/bondiola-de-cerdo/paso-06.webp"
        },
        {
          "title": "Let it rest for 15 minutes",
          "content": "Move the pork to a board and cover loosely with foil. Let it rest for 15 minutes: the juices redistribute instead of running out at the first cut.",
          "image_alt": "Pork neck resting on a cutting board before slicing",
          "image_url": "/recetas/bondiola-de-cerdo/paso-07.webp"
        },
        {
          "title": "Make the pan sauce",
          "content": "Strain the pan juices into a saucepan and skim off excess fat from the surface. Boil over medium heat for 5 to 8 minutes, scraping the bottom, until it thickens slightly. Taste and adjust the salt.",
          "image_alt": "Pan juices being reduced into a sauce",
          "image_url": "/recetas/bondiola-de-cerdo/paso-08.webp"
        },
        {
          "title": "Slice and serve",
          "content": "Slice the pork into ½-inch (1.5 cm) rounds, against the grain. Serve hot with the reduced pan juices on top, roast potatoes and chimichurri or Argentine salad.",
          "image_alt": "Sliced pork neck with pan juices, roast potatoes and chimichurri",
          "image_url": "/recetas/bondiola-de-cerdo/paso-09.webp"
        }
