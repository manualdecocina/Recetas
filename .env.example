# Manual de Cocina — variables de entorno de referencia.
# Nunca commitear valores reales de llaves privadas.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL canónica pública. En producción debe ser exactamente https://manualdecocina.com
NEXT_PUBLIC_SITE_URL=https://manualdecocina.com

# Host real de preview usado para assets sociales mientras preview permanece noindex.
NEXT_PUBLIC_PREVIEW_SITE_URL=https://preview.manualdecocina.com

# Opcional: origen dedicado para assets locales si en el futuro se usa CDN.
NEXT_PUBLIC_ASSET_BASE_URL=

# Anti-indexación: false en preview/pruebas. true SOLO tras aprobar el production gate.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Dominios extra permitidos por next/image, separados por coma.
NEXT_PUBLIC_IMAGE_HOSTS=

# Invalida cache desde fuera del panel vía /api/revalidate?secret=...
REVALIDATE_SECRET=

# AdSense. El publisher aprobado es pub-2592990699767586 (ver public/ads.txt).
# Mantener ambos desactivados en preview.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CMP_READY=false

# Ratings: apagados por defecto. Solo activar después de configurar los secretos server-side.
NEXT_PUBLIC_RATINGS_ENABLED=false

# Llave PRIVADA server-side para el endpoint de ratings.
# Preferir la nueva Supabase Secret Key (sb_secret_...) cuando esté disponible.
# SUPABASE_SERVICE_ROLE_KEY es el fallback legacy. Nunca usar NEXT_PUBLIC_ para estas llaves.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Secreto aleatorio largo usado para HMAC de la identidad técnica de voto.
RATINGS_HASH_SECRET=
