# Copiar a .env.local (desarrollo) y configurar las mismas variables en Hostinger (producción).
# Valores en Supabase → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública del sitio, usada para canonical, hreflang y sitemap.
NEXT_PUBLIC_SITE_URL=https://manualdecocina.com

# Seguro anti-duplicado: "false" (o vacío) en preview.manualdecocina.com y cualquier
# entorno de prueba. "true" SOLO en el dominio final cuando esté listo para Google.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Dominios extra permitidos para imágenes, separados por coma (el de Supabase ya
# está incluido automáticamente). Ejemplo: cdn.manualdecocina.com
NEXT_PUBLIC_IMAGE_HOSTS=

# ID de publisher de Google AdSense (formato "ca-pub-XXXXXXXXXXXXXXXX"), de la cuenta
# de AdSense de Néstor. Vacío en preview y en cualquier entorno de prueba: el sitio no
# carga ningún script de AdSense. Al definirla en producción (Hostinger) y volver a
# desplegar, los anuncios se activan solos, sin tocar código — pero solo sirven anuncios
# una vez que Google haya aprobado el sitio en su panel de AdSense.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# NOTA: SUPABASE_SERVICE_ROLE_KEY ya no se usa. El panel escribe con la sesión del
# administrador y la RLS decide los permisos. No agregar esa llave al proyecto.

# Secreto para forzar la invalidación de caché desde fuera del panel (SQL directo,
# scripts de importación) vía POST/GET a /api/revalidate?secret=... Elige un valor
# aleatorio largo y configúralo igual en Hostinger (preview y producción). Sin esta
# variable, /api/revalidate responde 500 en vez de quedar abierta sin protección.
REVALIDATE_SECRET=
